{
  "name": "stores-consulting-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/run-with-tina.mjs dev",
    "build": "node scripts/run-with-tina.mjs build",
    "preview": "astro preview",
    "astro": "astro",
    "migrate": "node scripts/migrate-wordpress.mjs && node scripts/import-mockup-assets.mjs",
    "check": "node scripts/run-with-tina.mjs check",
    "tina:audit": "tinacms audit --noTelemetry",
    "validate:html": "find dist/client -name '*.html' -not -path '*/wp-content/*' -not -path '*/admin/*' -print0 | xargs -0 html-validate",
    "validate:links": "node scripts/check-links.mjs",
    "validate:navigation": "node scripts/check-navigation.mjs",
    "validate:routes": "node scripts/check-route-manifest.mjs",
    "test:e2e": "playwright test",
    "validate": "npm run check && npm run build && npm run validate:html && npm run validate:links && npm run validate:navigation && npm run validate:routes"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.8",
    "@tinacms/astro": "^0.6.1",
    "astro": "^7.2.6",
    "resend": "^6.22.1",
    "tinacms": "^3.12.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "^1.62.1",
    "@tinacms/cli": "^2.6.1",
    "cheerio": "^1.2.0",
    "html-validate": "^11.10.0",
    "linkinator": "^8.0.4",
    "sharp": "^0.35.3",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  }
}
