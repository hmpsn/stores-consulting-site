---
export interface BreadcrumbItem {
  label: string;
  href?: string; editField?:string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href && index < items.length - 1
          ? <a href={item.href} data-tina-field={item.editField}>{item.label}</a>
          : <span data-tina-field={item.editField} aria-current={index === items.length - 1 ? 'page' : undefined}>{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>
