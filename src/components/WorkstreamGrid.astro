---
import { tinaField } from '@tinacms/astro/tina-field';
interface Workstream {
  _content_source?: {queryId:string;path:(string|number)[]};
  title: string;
  description: string;
}
interface Props {
  items: Workstream[];
  headingLevel?: 2 | 3 | 4;
}
const { items, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---

<ol class="workstream-grid">
  {items.map((item, index) => (
    <li data-reveal>
      <span class="workstream-grid__number">{String(index + 1).padStart(2, '0')}</span>
      <Heading class="card-title" data-tina-field={tinaField(item,'title')}>{item.title}</Heading>
      <p data-tina-field={tinaField(item,'description')}>{item.description}</p>
    </li>
  ))}
</ol>
