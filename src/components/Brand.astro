---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={['brand', { 'brand--compact': compact }]}>
  <span class="brand__mark" aria-hidden="true">
    <span class="brand__shelf brand__shelf--one"></span>
    <span class="brand__shelf brand__shelf--two"></span>
    <span class="brand__item"></span>
    <span class="brand__shelf brand__shelf--three"></span>
  </span>
  <span class="brand__type">
    <span class="brand__wordmark">the Stores</span>
    <span class="brand__descriptor">Consulting Group</span>
  </span>
</span>
