---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Content from './editable/CtaContent.astro';
interface Props {title?:string;description?:string;href?:string;label?:string;}
const params = Object.fromEntries(Object.entries(Astro.props).filter(([,value])=>value!==undefined));
---
<TinaIsland name="globalCta" params={params} wrapper={{tag:"div"}}><Content {...Astro.props}/></TinaIsland>
