---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Content from './editable/FooterContent.astro';
import {getGlobalSettings} from '../lib/tina-extended-data';
import type {NavSection} from '../data/navigation';
interface Props {activeSection?: NavSection;}
const {activeSection} = Astro.props;
const settings = await getGlobalSettings();
const currentPath = Astro.url.pathname;
---
<TinaIsland wrapper={{tag:"div",className:"tina-chrome"}} name="globalFooter" params={{activeSection:activeSection || '',currentPath}}><Content settings={settings} activeSection={activeSection} currentPath={currentPath}/></TinaIsland>
