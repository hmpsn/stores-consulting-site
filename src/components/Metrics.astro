---
interface Metric {
  value: string;
  label: string;
}
interface Props {
  items: Metric[];
  note?: string;
}
const { items, note } = Astro.props;
---

<div class="metrics">
  <dl class="metrics__grid">
    {items.map((item) => (
      <div class="metrics__item" data-reveal>
        <dt>{item.value}</dt>
        <dd>{item.label}</dd>
      </div>
    ))}
  </dl>
  {note && <p class="metrics__note">{note}</p>}
</div>
