---
import Brand from '../Brand.astro';
import { navigationLabel, footerGroups, inferNavSection, type NavSection } from '../../data/navigation';

const year = new Date().getFullYear();
interface Props { activeSection?: NavSection; settings: any; currentPath?: string; }
const { activeSection = inferNavSection(Astro.url.pathname), settings } = Astro.props;
const labels = settings.navigation;
const labelFor = (href: string, fallback: string) => navigationLabel(labels, href, fallback);
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <a href="/" aria-label="the Stores Consulting Group home"><Brand compact /></a>
    <nav class="site-footer__nav" aria-label="Footer navigation">
      {footerGroups.map((group) => (
        <section class="site-footer__group" aria-labelledby={`footer-${group.label.toLowerCase()}`}>
          <h2 id={`footer-${group.label.toLowerCase()}`}>{settings.footer[group.label.toLowerCase()]}</h2>
          <ul>
            {group.links.map((link) => (
              <li><a href={link.href} aria-current={('section' in link ? activeSection === link.section : Astro.url.pathname === link.href) ? 'page' : undefined}>{labelFor(link.href, link.label)}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
    <p class="site-footer__legal">© {year} {settings.footer.organization} · {settings.footer.location}</p>
  </div>
</footer>
