---
import {navigationItem} from '../../lib/navigation-editing';
import {getEditorialList} from '../../lib/tina-extended-data';
import {tinaField} from '@tinacms/astro/tina-field';
import Brand from '../Brand.astro';
import { inferNavSection, primaryLinks, serviceLinks, type NavSection } from '../../data/navigation';

const currentPath = Astro.props.currentPath || Astro.url.pathname;
interface Props { activeSection?: NavSection; settings: any; currentPath?: string; }
const { activeSection = inferNavSection(currentPath), settings } = Astro.props;
const labels = settings.navigation;
const services=await getEditorialList('service');
const itemFor=(href:string,fallback:string)=>navigationItem(settings,services,href,fallback);
const labelFor=(href:string,fallback:string)=>itemFor(href,fallback).label;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="the Stores Consulting Group home">
      <Brand />
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        <li>
          <details class="desktop-nav__disclosure">
            <summary aria-current={activeSection === 'services' ? 'page' : undefined} data-tina-field={tinaField(labels,'services')}>{labels.services}</summary>
            <div class="desktop-nav__panel">
              <a class="desktop-nav__overview" href={serviceLinks[0].href} aria-current={currentPath === serviceLinks[0].href ? 'page' : undefined} data-tina-field={tinaField(labels,'servicesOverview')}>{labelFor(serviceLinks[0].href, serviceLinks[0].label)} <span aria-hidden="true">→</span></a>
              <ul>
                {serviceLinks.slice(1).map((link, index) => (
                  <li><a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined} data-tina-field={itemFor(link.href,link.label).field}><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{labelFor(link.href, link.label)}</a></li>
                ))}
              </ul>
            </div>
          </details>
        </li>
        {primaryLinks.map((link) => (
          <li><a href={link.href} aria-current={activeSection === link.section ? 'page' : undefined} data-tina-field={itemFor(link.href,link.label).field}>{labelFor(link.href, link.label)}</a></li>
        ))}
      </ul>
    </nav>
    <a class="button button--small site-header__cta" href="/contact-us/" data-tina-field={tinaField(labels,'contactAction')}>{labels.contactAction}</a>
    <details class="mobile-nav">
      <summary data-tina-field={tinaField(labels,'menu')}>{labels.menu}</summary>
      <nav aria-label="Mobile navigation">
        <ul>
          <li class="mobile-nav__section">
            <span class="mobile-nav__label" data-tina-field={tinaField(labels,'services')}>{labels.services}</span>
            <ul class="mobile-nav__subnav">
              {serviceLinks.map((link) => (
                <li><a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined} data-tina-field={itemFor(link.href,link.label).field}>{labelFor(link.href, link.label)}</a></li>
              ))}
            </ul>
          </li>
          {primaryLinks.map((link) => (
            <li><a href={link.href} aria-current={activeSection === link.section ? 'page' : undefined} data-tina-field={itemFor(link.href,link.label).field}>{labelFor(link.href, link.label)}</a></li>
          ))}
          <li><a href="/contact-us/" data-tina-field={tinaField(labels,'contactAction')}>{labels.contactAction}</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const disclosures = () => document.querySelectorAll<HTMLDetailsElement>('.desktop-nav__disclosure, .mobile-nav');
  // Delegation survives Tina replacing the header island after an edit.
  document.addEventListener('toggle', (event) => {
    const disclosure = event.target;
    if (!(disclosure instanceof HTMLDetailsElement) || !disclosure.matches('.desktop-nav__disclosure, .mobile-nav') || !disclosure.open) return;
    disclosures().forEach(other => { if (other !== disclosure) other.open = false; });
  }, true);

  document.addEventListener('pointerdown', (event) => {
    disclosures().forEach((disclosure) => {
      if (!disclosure.contains(event.target as Node)) disclosure.open = false;
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    disclosures().forEach((disclosure) => {
      if (!disclosure.open) return;
      disclosure.open = false;
      disclosure.querySelector('summary')?.focus();
    });
  });
</script>
