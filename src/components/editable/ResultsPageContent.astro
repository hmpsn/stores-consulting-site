---
import PageIntro from '../PageIntro.astro';
import CtaBand from '../CtaBand.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { ResultsPageQuery } from '../../../tina/__generated__/types';
interface Props { data: ResultsPageQuery['resultsPage']; related?: any; }
const { data } = Astro.props;
const copy = data.copy!;
const resultGroups = data.resultGroups!;
---
<div data-tina-field={tinaField(data, 'copy')}>

  <PageIntro eyebrow={copy.eyebrow3} title={copy.title4} description={copy.description5} measure="wide" />
  <section class="section"><div class="shell"><div class="section__heading" data-reveal><p class="eyebrow">{copy.text8}</p><h2>{copy.text9}</h2><p>{copy.text10}</p></div><div class="path-grid">{resultGroups.map((group) => <article class="path-card" data-reveal><h3>{group.title}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div></div></section>
  <section class="section section--soft"><div class="shell"><div class="section__heading section__heading--label-only" data-reveal><h2 class="eyebrow">{copy.text11}</h2></div><div class="principle-grid"><article class="principle-card" data-reveal><h3>{copy.text12}</h3><p>{copy.text13}</p></article><article class="principle-card" data-reveal><h3>{copy.text14}</h3><p>{copy.text15}</p></article></div></div></section>
  <CtaBand title={copy.title6} description={copy.description7} />


</div>
