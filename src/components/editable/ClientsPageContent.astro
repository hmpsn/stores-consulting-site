---
import PageIntro from '../PageIntro.astro';
import CtaBand from '../CtaBand.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { ClientsPageQuery } from '../../../tina/__generated__/types';
interface Props { data: ClientsPageQuery['clientsPage']; related?: any; }
const { data, related } = Astro.props;
const copy = data.copy!;
const clients = related.clients.map((data: any) => ({data}));
---
<div>

  <PageIntro title={copy.title3} description={copy.description4} measure="wide" editFields={{title: tinaField(copy, 'title3'), description: tinaField(copy, 'description4')}} />
  <section class="section"><div class="shell"><div class="client-logo-grid">{data.logos!.map((logo) => <a class="client-logo-card" href={logo.href} data-reveal data-tina-field={tinaField(logo,'href')}><img data-tina-field={tinaField(logo.image,'src')} src={logo.image.src} width={logo.image.width} height={logo.image.height} alt={logo.image.alt} loading="lazy" /><span data-tina-field={tinaField(logo,'name')}>{logo.name}</span></a>)}</div><p class="metrics__note" data-tina-field={tinaField(copy, 'text7')}>{copy.text7}</p></div></section>
  <section class="section section--soft"><div class="shell"><div class="section__heading" data-reveal><p class="eyebrow" data-tina-field={tinaField(copy, 'text8')}>{copy.text8}</p><h2 data-tina-field={tinaField(copy, 'text9')}>{copy.text9}</h2><p data-tina-field={tinaField(copy, 'text10')}>{copy.text10}</p></div><ul class="link-archive-grid">{clients.map((client: any) => <li data-reveal><a class="text-link" href={client.data.route} data-tina-field={tinaField(client.data,'name')}>{client.data.name}</a></li>)}</ul></div></section>
  <CtaBand title={copy.title5} description={copy.description6} editFields={{title: tinaField(copy, 'title5'), description: tinaField(copy, 'description6')}} />


</div>
