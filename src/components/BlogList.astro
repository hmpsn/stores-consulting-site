---
interface Post {
  title: string;
  route: string;
  excerpt: string;
  publishedDate: Date;
  author: string;
}
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const date = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<ol class="blog-list">
  {posts.map((post) => (
    <li>
      <article data-reveal>
        <p class="blog-list__meta">{date.format(post.publishedDate)} · {post.author.replace(/-/g, ' ')}</p>
        <div class="blog-list__content">
          <h2><a href={post.route}>{post.title}</a></h2>
          {post.excerpt && <p>{post.excerpt}</p>}
          <a class="text-link" href={post.route}>Read article →</a>
        </div>
      </article>
    </li>
  ))}
</ol>
