---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  eager?: boolean;
  position?: string;
  class?: string;
  dataReveal?: boolean;
  editField?: string;
}

const {
  src,
  alt,
  width,
  height,
  eager = false,
  position = 'center',
  class: className,
  dataReveal = false,
  editField,
} = Astro.props;
---

<figure class:list={['field-image', className]} style={`--field-image-position: ${position}`} data-reveal={dataReveal || undefined} data-tina-field={editField}>
  <div class="field-image__frame">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : undefined}
    />
  </div>
</figure>
