---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  eager?: boolean;
  position?: string;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  eager = false,
  position = 'center',
  class: className,
} = Astro.props;
---

<figure class:list={['fm-image', className]} style={`--fm-image-position: ${position}`}>
  <div class="fm-image__frame">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : undefined}
    />
  </div>
</figure>
