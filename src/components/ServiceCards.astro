---
interface Service {
  title: string;
  slug: string;
  order: number;
  summary: string;
}
interface Props {
  services: Service[];
  headingLevel?: 2 | 3 | 4;
}
const { services, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---

<div class="service-grid">
  {services.sort((a, b) => a.order - b.order).map((service) => (
    <a class="service-card" href={`/services/${service.slug}/`} data-reveal>
      <span class="service-card__number">Aisle {String(service.order).padStart(2, '0')}</span>
      <Heading class="card-title">{service.title}</Heading>
      <p>{service.summary}</p>
      <span class="service-card__link">Explore this aisle →</span>
    </a>
  ))}
</div>
