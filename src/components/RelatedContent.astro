---
import {tinaField} from '@tinacms/astro/tina-field';
import {getEditorialList,getGlobalSettings} from '../lib/tina-extended-data';
interface Props {paths?: (string|null)[]|null; kind?:'work'|'services'; selectionField?:string;}
const {paths=[],kind='work',selectionField}=Astro.props;
const labels=(await getGlobalSettings()).labels;
const key=kind==='services'?'relatedServices':'relatedWork';
const selected=[...new Set(paths||[])].filter(Boolean) as string[];
const groups=[...new Set(selected.map(path=>path.startsWith('/services/')?'service':path.startsWith('/project/')?'clientProfile':'post'))];
const records=(await Promise.all(groups.map(group=>getEditorialList(group as 'service'|'clientProfile'|'post')))).flat();
const links=selected.map(path=>records.find(record=>!record.draft&&(record.route||`/services/${record.slug}/`)===path)).filter(Boolean);
---
{links.length>0&&<section class="section section--paper" data-tina-field={selectionField}><div class="shell"><div class="section__heading"><h2 data-tina-field={tinaField(labels,key)}>{labels[key]}</h2></div><ul class="link-archive-grid">{links.map(link=><li><a class="text-link" href={link.route||`/services/${link.slug}/`} data-tina-field={tinaField(link,link.title?'title':'name')}>{link.title||link.name}</a></li>)}</ul></div></section>}

{selectionField&&<div class="shell" data-editor-controls><button type="button" class="button button--outline" data-tina-field={selectionField}>Edit related links</button></div>}
