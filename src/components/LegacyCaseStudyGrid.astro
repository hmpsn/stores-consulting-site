---
import {tinaField} from '@tinacms/astro/tina-field';
import {getGlobalSettings} from '../lib/tina-extended-data';
interface Props {entries:any[];}
const {entries=[]}=Astro.props;
const labels=(await getGlobalSettings()).labels;
---
<p class="eyebrow" data-tina-field={tinaField(labels,'clientDirectory')}>{labels.clientDirectory}</p>
<ul class="legacy-case-grid">{entries.filter(Boolean).map(entry=><li data-reveal><a href={entry.url} data-tina-field={tinaField(entry,'url')}><span class="legacy-case-grid__media"><img src={entry.image} alt={entry.alt} width={entry.width} height={entry.height} loading="lazy" decoding="async" data-tina-field={tinaField(entry,'image')}/></span><div class="legacy-case-grid__copy"><h2 data-tina-field={tinaField(entry,'title')}>{entry.title}</h2><time data-tina-field={tinaField(entry,'date')}>{entry.date}</time></div></a></li>)}</ul>
