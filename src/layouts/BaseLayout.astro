---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteMotion from '../components/SiteMotion.astro';
import type { NavSection } from '../data/navigation';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  article?: boolean;
  noindex?: boolean;
  navSection?: NavSection;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = '/assets/brand/social-card.png',
  article = false,
  noindex = false,
  navSection,
} = Astro.props;
const siteName = 'the Stores Consulting Group';
const titleCandidate = title === siteName ? title : `${title} | ${siteName}`;
const pageTitle = titleCandidate.length > 62 ? `${titleCandidate.slice(0, 61).trimEnd()}…` : titleCandidate;
const canonical = new URL(canonicalPath, Astro.site || Astro.url.origin);
const socialImage = new URL(image, Astro.site || Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {image === "/assets/brand/social-card.png" && <>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="the Stores Consulting Group — shelf register identity" />
    </>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="tSCG Blog" href="/feed/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteMotion />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header activeSection={navSection} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer activeSection={navSection} />
  </body>
</html>
