---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import HomepageContent from '../components/editable/HomepageContent.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHomepage } from '../lib/tina-data';
import { tinaIslands } from '../lib/tina-islands';

const homepage = await getHomepage();
const data = homepage.data.homepage;
const metadata = data.metadata!;
---

<BaseLayout seo={data.seo} title={metadata.title} description={metadata.description} canonicalPath="/">
  <TinaIsland name="homepage" wrapper={tinaIslands.homepage.wrapper} primary>
    <HomepageContent data={data} />
  </TinaIsland>
</BaseLayout>
