---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Brand from '../../components/Brand.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import FieldImage from '../../components/FieldImage.astro';
import Metrics from '../../components/Metrics.astro';
import PageIntro from '../../components/PageIntro.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import WorkstreamGrid from '../../components/WorkstreamGrid.astro';

const palette = [
  { id: 'ink', name: 'Ink', token: '--ink', value: '#17242d' },
  { id: 'ink-deep', name: 'Ink deep', token: '--ink-deep', value: '#101a20' },
  { id: 'mineral', name: 'Mineral', token: '--mineral', value: '#2f5c66' },
  { id: 'signal', name: 'Signal', token: '--signal', value: '#b34929' },
  { id: 'paper', name: 'Paper', token: '--paper', value: '#f3f0e8' },
  { id: 'surface', name: 'Surface', token: '--surface', value: '#ffffff' },
  { id: 'surface-soft', name: 'Surface soft', token: '--surface-soft', value: '#eef1ef' },
  { id: 'muted', name: 'Muted', token: '--muted', value: '#52636a' },
  { id: 'line', name: 'Line', token: '--line', value: '#b8c0be' },
  { id: 'line-soft', name: 'Line soft', token: '--line-soft', value: '#d8ddda' },
];

const spacing = [
  ['1', '0.375rem'], ['2', '0.75rem'], ['3', '1rem'], ['4', '1.5rem'],
  ['5', '2rem'], ['6', '3rem'], ['7', '4.5rem'], ['8', '6rem'],
];

const sampleServices = [
  { title: 'Primary Service Pattern', slug: 'shrink-profit-recovery', order: 1, summary: 'Numbered service cards use strong hierarchy, generous inset, and a full-card link.' },
  { title: 'Secondary Service Pattern', slug: 'fresh-inventory-operations', order: 2, summary: 'Cards remain editorial and structured rather than decorative or overly rounded.' },
];

const sampleWorkstreams = [
  { title: 'Diagnose', description: 'Establish the operational baseline and identify the actual execution gap.' },
  { title: 'Prove', description: 'Test the standard in a controlled environment with measurable outcomes.' },
  { title: 'Scale', description: 'Transfer the working model through field ownership and accountability.' },
];
---

<BaseLayout
  title="Interface Style Guide"
  description="Canonical reference for the approved tSCG Operational Field Manual design system."
  canonicalPath="/styleguide/"
  noindex
>
  <PageIntro
    eyebrow="Internal · Canonical Reference"
    title="Operational Field Manual"
    description="The approved sitewide source of truth for tokens, typography, spacing, imagery, motion, elements, components, forms, and editorial templates."
    compact
    measure="standard"
  >
    <nav aria-label="Style guide sections">
      <ul class="styleguide-nav">
        <li><a href="#foundations">Foundations</a></li>
        <li><a href="#identity">Identity</a></li>
        <li><a href="#typography">Typography</a></li>
        <li><a href="#spacing">Spacing</a></li>
        <li><a href="#imagery">Imagery</a></li>
        <li><a href="#motion">Motion</a></li>
        <li><a href="#elements">Elements</a></li>
        <li><a href="#components">Components</a></li>
        <li><a href="#forms">Forms</a></li>
        <li><a href="#editorial">Editorial templates</a></li>
      </ul>
    </nav>
  </PageIntro>

  <div class="styleguide">
    <section class="section" id="foundations" aria-labelledby="foundations-heading">
      <div class="shell">
        <header class="styleguide-heading" data-reveal>
          <p class="eyebrow">Foundations</p>
          <h2 id="foundations-heading">A restrained operating palette.</h2>
          <p>Ink provides authority, mineral adds a practical retail tone, signal is reserved for emphasis and action, and paper keeps the system tactile without becoming nostalgic. White surface leads primary heroes and gives evidence cards definition when they sit on paper.</p>
        </header>
        <div class="brand-guidance" data-reveal>
          <div class="brand-guidance__sample"><Brand /></div>
          <div class="brand-guidance__rules">
            <h3>Shelf register identity</h3>
            <p>The three shelf rules and single signal item form the approved mark. The mark stays subordinate to the name, uses no enclosing tile, and must remain legible in one color.</p>
            <ul>
              <li>Use the full lockup for headers, footers, documents, and social graphics.</li>
              <li>Use the shelf register alone only when the company name is already explicit.</li>
              <li>Do not redraw the mark as a letter, add a container, or separate the descriptor with a rule.</li>
            </ul>
          </div>
        </div>
        <div class="token-grid">
          {palette.map((color) => (
            <article class="token-card" data-reveal>
              <span class:list={['token-card__swatch', `token-card__swatch--${color.id}`]}></span>
              <strong>{color.name}</strong>
              <code>{color.token}</code>
              <span>{color.value}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--paper" id="identity" aria-labelledby="identity-heading">
      <div class="shell">
        <header class="styleguide-heading" data-reveal>
          <p class="eyebrow">Identity review</p>
          <h2 id="identity-heading">The Shelf Register is the selected identity.</h2>
          <p>Selected for the team handoff on September 8, 2026. Use the icon and wordmark together across the site. The Pure Wordmark is retained only as an archived comparison; the identity may be revisited after the conversation with Marty.</p>
        </header>
        <div class="logo-review-grid">
          <article class="logo-option" id="logo-option-pure-wordmark" data-reveal>
            <header class="logo-option__meta">
              <span>Archived comparison</span>
              <h3>Pure Wordmark</h3>
              <p>The name carries the identity. “The” is tucked into the primary wordmark and the descriptor sits on its own optical baseline.</p>
            </header>
            <div class="logo-option__sample" role="img" aria-label="Pure Wordmark logo concept: the Stores Consulting Group">
              <div class="review-wordmark">
                <div class="review-wordmark__name">
                  <span>the</span>
                  <strong>Stores</strong>
                </div>
                <div class="review-wordmark__descriptor">Consulting Group</div>
              </div>
            </div>
            <footer>The name is the mark.</footer>
          </article>

          <article class="logo-option logo-option--active" id="logo-option-shelf-register" data-reveal>
            <header class="logo-option__meta">
              <span>Selected · Sitewide</span>
              <h3>Shelf Register</h3>
              <p>Three shelf rules create the operating field. One signal item records the intervention without becoming a letter or generic icon.</p>
            </header>
            <div class="logo-option__sample logo-option__sample--shelf" role="img" aria-label="Shelf Register logo concept: the Stores Consulting Group">
              <Brand />
            </div>
            <footer>Observe. Align. Execute.</footer>
          </article>
        </div>
        <p class="metrics__note">The header and footer use <code>Brand.astro</code>. Browser and saved-page icons use the shelf register alone; sharing previews use the full lockup. Regenerate exported assets with <code>node scripts/generate-brand-assets.mjs</code> when the identity changes.</p>
        <img src="/assets/brand/social-card.png" alt="Selected Shelf Register identity on the default social-sharing card" width="1200" height="630" loading="lazy" />
      </div>
    </section>

    <section class="section section--paper" id="typography" aria-labelledby="typography-heading">
      <div class="shell">
        <header class="styleguide-heading" data-reveal>
          <p class="eyebrow">Typography</p>
          <h2 id="typography-heading">Archivo leads. Source Sans 3 carries.</h2>
          <p>Display type is compact, direct, and sentence-cased. Seven named tiers use role-specific leading and tracking so page titles compress with authority, card titles stay readable, and body copy retains an open working rhythm.</p>
        </header>
        <div class="type-specimens">
          <article class="type-specimen" data-reveal>
            <p class="type-specimen__meta">Display · Archivo · 650 · 0.94</p>
            <p class="type-specimen__display">Decades inside retail. Not just around it.</p>
          </article>
          <article class="type-specimen" data-reveal>
            <p class="type-specimen__meta">Section · Archivo · 650 · 0.99</p>
            <p class="type-specimen__section">The execution gap is the only gap left.</p>
          </article>
          <article class="type-specimen" data-reveal>
            <p class="type-specimen__meta">Subsection · Archivo · 650 · 1.04</p>
            <p class="type-specimen__subheading">Challenge one: finding it</p>
          </article>
          <article class="type-specimen" data-reveal>
            <p class="type-specimen__meta">Card title · Archivo · 650 · 1.09</p>
            <p class="type-specimen__card">Inventory management</p>
          </article>
          <article class="type-specimen" data-reveal>
            <p class="type-specimen__meta">Lead · Source Sans 3 · 400 · 1.46</p>
            <p class="type-specimen__lead">Lead copy frames the argument before the operational detail begins.</p>
          </article>
          <article class="type-specimen" data-reveal>
            <p class="type-specimen__meta">Body · Source Sans 3 · 400 · 1.58</p>
            <p class="type-specimen__body">The body system prioritizes readable measure, clear hierarchy, and enough air for operational detail without drifting into generic corporate polish.</p>
          </article>
          <article class="type-specimen" data-reveal>
            <p class="type-specimen__meta">Supporting · Source Sans 3 · 400</p>
            <p class="type-specimen__supporting">Published January 4, 2018 · Industry perspective</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="spacing" aria-labelledby="spacing-heading">
      <div class="shell">
        <header class="styleguide-heading" data-reveal>
          <p class="eyebrow">Spacing &amp; containers</p>
          <h2 id="spacing-heading">One rhythm from cards to full sections.</h2>
          <p>The site uses an eight-step spacing scale, a restrained 4–6rem section rhythm, an 80rem maximum shell, responsive gutters, and separate lead and prose measures. Components size to their content; minimum heights are reserved for patterns that genuinely require equalized rows.</p>
        </header>
        <div class="spacing-scale">
          {spacing.map(([step, value]) => (
            <div class="spacing-token" data-reveal>
              <span class={`spacing-token__bar spacing-token__bar--${step}`}></span>
              <code>--space-{step}</code>
              <small>{value}</small>
            </div>
          ))}
        </div>
        <div class="container-demo" data-reveal>
          <span>Responsive shell · max 80rem</span>
          <div class="container-demo__lead">
            <span>Section lead · max 61rem</span>
            <div><span>Wide intro · 68rem copy / 52rem lead</span></div>
          </div>
          <div class="container-demo__prose"><span>Long-form prose · max 48rem</span></div>
        </div>
      </div>
    </section>

    <section class="section section--soft" id="imagery" aria-labelledby="imagery-heading">
      <div class="shell">
        <header class="styleguide-heading" data-reveal>
          <p class="eyebrow">Imagery</p>
          <h2 id="imagery-heading">Use images as evidence, not decoration.</h2>
          <p>Strong, relevant assets may lead a hero or support a result section. Pages without an approved asset remain intentionally text-led—never filled with placeholders or repeated generic stock.</p>
        </header>
        <div class="imagery-grid">
          <FieldImage
            src="/wp-content/uploads/2016/09/iStock-543570406_2.jpg"
            alt="A contemporary clothing store with merchandise arranged across display tables and racks."
            width={2048}
            height={1365}
            position="center"
            dataReveal
          />
          <div class="styleguide-rule" data-reveal>
            <h3>Image requirements</h3>
            <ul>
              <li>Every image has a defined editorial role.</li>
              <li>Intrinsic width and height are required.</li>
              <li>Alt text describes the visible subject, not a marketing claim.</li>
              <li>Crop position is explicit when the default center crop is unsuitable.</li>
              <li>Text-led layouts are the approved fallback.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--dark" id="motion" aria-labelledby="motion-heading">
      <div class="shell">
        <header class="styleguide-heading" data-reveal>
          <p class="eyebrow">Motion</p>
          <h2 id="motion-heading">Subtle, directional, and optional.</h2>
          <p>Explicit reveal hooks receive one short upward fade as they enter the viewport. Navigation and content remain complete without JavaScript, and reduced-motion preferences remove the effect. Embedded previews, including Tina, keep content visible without entrance motion so section refreshes never hide editable content.</p>
        </header>
        <div class="motion-sample" data-reveal>
          <span aria-hidden="true"></span>
          <p><strong>620ms</strong> · controlled ease-out · one entrance · no looping decoration</p>
        </div>
      </div>
    </section>

    <section class="section" id="elements" aria-labelledby="elements-heading">
      <div class="shell">
        <header class="styleguide-heading" data-reveal>
          <p class="eyebrow">Elements</p>
          <h2 id="elements-heading">Labels earn their place.</h2>
          <p>Eyebrows are for orientation—evidence, methodology, post context, client profiles, aisle indexing, or status. They are omitted when the heading already says “About,” “Contact,” or “Our Approach.”</p>
        </header>
        <div class="element-grid">
          <div class="styleguide-rule" data-reveal>
            <p class="eyebrow">Methodology · Appropriate</p>
            <h3>Use a label when it changes how the reader interprets the section.</h3>
          </div>
          <div class="styleguide-rule" data-reveal>
            <h3>Skip redundant orientation.</h3>
            <p>The page title and surrounding structure usually provide enough context.</p>
          </div>
          <div class="styleguide-rule" data-reveal>
            <h3>Actions</h3>
            <div class="styleguide-actions">
              <a class="button" href="#components">Primary action</a>
              <a class="button button--outline" href="#editorial">Secondary action</a>
              <a class="text-link" href="#forms">Text action →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--paper" id="components" aria-labelledby="components-heading">
      <div class="shell">
        <header class="styleguide-heading" data-reveal>
          <p class="eyebrow">Components</p>
          <h2 id="components-heading">Shared patterns own presentation.</h2>
          <p>Content records supply validated words and media. Components supply hierarchy, responsive behavior, focus states, and visual rhythm. Tina exposes these content fields across the public site; editor wrappers use display: contents around site chrome to preserve sticky behavior. Optional team portraits use a square crop. Existing layouts and URLs remain code-owned.</p>
        </header>
        <section class="styleguide-component" aria-labelledby="navigation-pattern-heading">
          <h3 id="navigation-pattern-heading">Primary navigation</h3>
          <p>The compact header remains sticky without resizing. What We Do uses a keyboard-accessible disclosure for the services overview and all four service routes; Blog is a primary destination. Mobile navigation exposes the same hierarchy in an independently scrollable disclosure, and every route family supplies an explicit active state.</p>
        </section>
        <section class="styleguide-component" aria-labelledby="wayfinding-pattern-heading">
          <h3 id="wayfinding-pattern-heading">Breadcrumbs and return paths</h3>
          <p>Detail routes use semantic breadcrumbs inside their introduction. Top-level marketing pages do not. Posts also link their author, categories, Blog index, and chronological neighbors; generic legacy pages receive only a Home return path.</p>
          <div class="styleguide-rule">
            <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'What We Do', href: '/services/' }, { label: 'Service detail' }]} />
            <h4>Breadcrumbs orient without competing with the page title.</h4>
          </div>
        </section>
        <section class="styleguide-component" aria-labelledby="footer-pattern-heading">
          <h3 id="footer-pattern-heading">Footer hierarchy</h3>
          <p>The footer groups destinations as Services, Company, and Explore. Generic legacy pages remain intentionally absent from global navigation.</p>
        </section>
        <section class="styleguide-component" aria-labelledby="page-intro-pattern-heading">
          <h3 id="page-intro-pattern-heading">Page introductions</h3>
          <p>Marketing introductions explicitly request the 68rem wide measure. Compact archives, profiles, 404 pages, and split-media introductions use the 58rem standard measure. Media presence never silently changes the intended text role.</p>
        </section>
        <section class="styleguide-component" aria-labelledby="principle-cards-heading">
          <h3 id="principle-cards-heading">Principle cards</h3>
          <p>Short principle collections use a content-driven two-column grid. Cards stretch only to match their row and collapse to one column at the compact breakpoint.</p>
        </section>
        <section class="styleguide-component" aria-labelledby="link-archive-heading">
          <h3 id="link-archive-heading">Link archives</h3>
          <p>Large preserved directories use their own reset, dividers, and three-to-two-to-one-column behavior rather than borrowing a card grid.</p>
          <ul class="link-archive-grid">
            <li><a class="text-link" href="/clients/">Directory entry one</a></li>
            <li><a class="text-link" href="/clients/">Directory entry two</a></li>
            <li><a class="text-link" href="/clients/">Directory entry three</a></li>
          </ul>
        </section>
        <section class="styleguide-component" aria-labelledby="services-pattern-heading">
          <h3 id="services-pattern-heading">Service cards</h3>
          <p>Related-content sections reuse the link archive grid with editor-selected titles. Published case studies use sequential Challenge, What we did, and Results headings in the existing prose column; unapproved case studies remain hidden. Cards use a full dark hover state to make the linked surface unmistakable while preserving the aisle hierarchy.</p>
          <ServiceCards services={sampleServices} headingLevel={4} />
        </section>
        <section class="styleguide-component" aria-labelledby="workstreams-pattern-heading">
          <h3 id="workstreams-pattern-heading">Workstreams</h3>
          <WorkstreamGrid items={sampleWorkstreams} headingLevel={4} />
        </section>
        <section class="styleguide-component" aria-labelledby="metrics-pattern-heading">
          <h3 id="metrics-pattern-heading">Metrics</h3>
          <Metrics items={[
            { value: '5–15%', label: 'A sample outcome formatted as a clear metric card' },
            { value: '20–60%', label: 'A second sample demonstrating repeated evidence' },
            { value: '7–10x', label: 'A third outcome with consistent visual priority' },
          ]} note="Metric values and claims must always come from approved source content." />
        </section>
        <section class="styleguide-component" aria-labelledby="principles-rail-heading">
          <h3 id="principles-rail-heading">Principles rail</h3>
          <p>Use a divided rail for a short set of parallel principles that need more presence than inline labels.</p>
          <div class="styleguide-dark-demo">
            <ul class="pill-list">
              <li>Vendor-agnostic</li>
              <li>Execution-first</li>
              <li>Built for adoption</li>
              <li>Measured in outcomes</li>
            </ul>
          </div>
        </section>
      </div>
    </section>

    <section class="section" id="forms" aria-labelledby="forms-heading">
      <div class="shell styleguide-form-layout">
        <header class="styleguide-heading" data-reveal>
          <p class="eyebrow">Forms</p>
          <h2 id="forms-heading">Plain, labeled, and resilient.</h2>
          <p>Labels remain visible, fields use the same line system as the rest of the site, and the production form remains usable without JavaScript.</p>
        </header>
        <form class="styleguide-form" data-reveal>
          <div class="form-grid">
            <div class="form-field"><label for="sample-name">Name</label><input id="sample-name" type="text" placeholder="Marty Reeser" /></div>
            <div class="form-field"><label for="sample-email">Email</label><input id="sample-email" type="email" placeholder="marty@example.com" /></div>
            <div class="form-field form-field--wide"><label for="sample-message">Message</label><textarea id="sample-message">A clear field for a clear request.</textarea></div>
          </div>
          <button class="button" type="submit">Send message</button>
        </form>
      </div>
    </section>

    <section class="section section--soft" id="editorial" aria-labelledby="editorial-heading">
      <div class="shell">
        <header class="styleguide-heading" data-reveal>
          <p class="eyebrow">Editorial templates</p>
          <h2 id="editorial-heading">Complete with or without media.</h2>
        </header>
        <div class="editorial-grid">
          <article data-reveal><span>01</span><h3>Marketing pages</h3><p>Page intro, flexible sections, evidence, and a single closing action.</p></article>
          <article data-reveal><span>02</span><h3>Service pages</h3><p>One shared template with optional hero and supporting media fields.</p></article>
          <article data-reveal><span>03</span><h3>Posts and archives</h3><p>Metadata and editorial content stay grouped in compact rows; long-form pages use a single readable measure. PDF report posts pair an embedded document preview with a persistent Open report link; video and report archive links state their format.</p></article>
          <article data-reveal><span>04</span><h3>Clients and legacy pages</h3><p>Project logos stay intrinsically sized, repeated media is removed from presentation, and image-led archives use a consistent gallery.</p></article>
        </div>
      </div>
    </section>
  </div>

  <CtaBand
    title="The guide is the contract for future pages."
    description="Reuse these tokens and components before introducing a new pattern."
    href="/"
    label="View the site"
  />
</BaseLayout>

<style>
  .styleguide-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.4rem;
    margin: var(--space-5) 0 0;
    padding: var(--space-3) 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .styleguide-nav a {
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 700;
    text-underline-offset: 0.25em;
    text-transform: uppercase;
  }

  .styleguide-heading {
    max-width: 50rem;
    margin-bottom: var(--space-6);
  }

  .styleguide-dark-demo {
    margin-top: var(--space-3);
    padding: var(--space-4);
    background: var(--ink-deep);
    color: var(--paper);
  }

  .styleguide-dark-demo .pill-list {
    margin-top: 0;
  }

  .styleguide-heading > p:last-child {
    max-width: 44rem;
    color: var(--muted);
    font-size: 1.18rem;
  }

  .section--dark .styleguide-heading > p:last-child {
    color: var(--text-dark-muted);
  }

  .brand-guidance {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr);
    margin-bottom: var(--space-6);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .brand-guidance__sample {
    display: grid;
    min-height: 15rem;
    place-items: center;
    padding: var(--space-5);
    border-right: 1px solid var(--line);
    background: var(--paper);
  }

  .brand-guidance__rules {
    padding: var(--space-5);
  }

  .brand-guidance__rules h3 {
    margin-bottom: var(--space-3);
  }

  .brand-guidance__rules p,
  .brand-guidance__rules li {
    color: var(--muted);
  }

  .logo-review-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .logo-option {
    display: grid;
    grid-template-rows: auto minmax(18rem, 1fr) auto;
    min-width: 0;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .logo-option--active {
    box-shadow: inset 0 0 0 2px var(--signal);
  }

  .logo-option__meta {
    padding: var(--space-4);
    border-bottom: 1px solid var(--line-soft);
  }

  .logo-option__meta > span,
  .logo-option > footer {
    color: var(--signal);
    font-family: var(--font-display);
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .logo-option__meta h3 {
    margin-block: var(--space-2);
  }

  .logo-option__meta p {
    max-width: 31rem;
    color: var(--muted);
  }

  .logo-option__sample {
    display: grid;
    min-width: 0;
    place-items: center;
    padding: clamp(3rem, 7vw, 6rem) var(--space-4);
    background: var(--paper);
  }

  .logo-option > footer {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--line-soft);
    color: var(--ink);
  }

  .review-wordmark {
    display: inline-grid;
    grid-template-columns: auto auto;
    column-gap: 0.12rem;
    row-gap: 0.22rem;
    color: var(--ink);
    font-family: var(--font-display);
  }

  .review-wordmark__name {
    display: contents;
  }

  .review-wordmark__name span {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    align-self: start;
    color: var(--muted);
