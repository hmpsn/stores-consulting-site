---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import BlogPageContent from '../../components/editable/BlogPageContent.astro';
import { getMarketingPage } from '../../lib/tina-extended-data';
const { data, related } = await getMarketingPage('blog');
const copy = data.copy;
---
<BaseLayout seo={data.seo} title={copy.title1} description={copy.description2} canonicalPath="/tscg-blog/" navSection="blog">
<TinaIsland name="blogPage" params={{}} primary wrapper={{tag:"div"}}>
<BlogPageContent data={data} related={related} />
</TinaIsland>
</BaseLayout>
