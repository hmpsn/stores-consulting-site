---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import ServicesIndexContent from '../../components/editable/ServicesIndexContent.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getServicesPage } from '../../lib/tina-data';
import { tinaIslands } from '../../lib/tina-islands';

const page = await getServicesPage();
const data = page.data.servicesPage;
const metadata = data.metadata!;
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath="/services/">
  <TinaIsland name="servicesIndex" wrapper={tinaIslands.servicesIndex.wrapper} primary>
    <ServicesIndexContent data={data} />
  </TinaIsland>
</BaseLayout>
