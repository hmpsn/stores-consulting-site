---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FieldImage from '../../components/FieldImage.astro';
import PageIntro from '../../components/PageIntro.astro';
import WorkstreamGrid from '../../components/WorkstreamGrid.astro';
import Metrics from '../../components/Metrics.astro';
import CtaBand from '../../components/CtaBand.astro';
import '../../styles/field-manual.css';

export async function getStaticPaths() {
  return (await getCollection('services')).map((service) => ({ params: { slug: service.data.slug }, props: { service: service.data } }));
}

const { service } = Astro.props;
const isShrinkPrototype = service.slug === 'shrink-profit-recovery';
---

<BaseLayout
  title={service.title}
  description={service.summary}
  canonicalPath={`/services/${service.slug}/`}
  fieldManual={isShrinkPrototype}
>
  {isShrinkPrototype ? (
    <div class="field-manual-page field-manual-service">
      <section class="fm-service-hero">
        <div class="fm-service-hero__copy">
          <h1>{service.title}</h1>
          <p class="fm-service-hero__summary">{service.summary}</p>
          <p class="fm-service-hero__thesis"><strong>{service.thesisLabel}</strong>{service.thesis}</p>
        </div>
        <FieldImage
          src="/wp-content/uploads/2016/09/iStock-506018790_02.jpg"
          alt="Rows of wine and spirits arranged on densely stocked retail shelves."
          width={2048}
          height={1486}
          position="center"
          eager
        />
      </section>

      <section class="section section--paper"><div class="shell"><div class="section__heading"><h2>Six workstreams, applied to your specific gap.</h2></div><WorkstreamGrid items={service.workstreams} /></div></section>

      <section class="section"><div class="shell fm-service-results">
        <FieldImage
          src="/wp-content/uploads/2016/10/iStock-506033946.jpg"
          alt="A retail aisle densely stocked with packaged household products."
          width={2048}
          height={1365}
          position="center"
        />
        <div class="fm-service-results__metrics"><h2>Results</h2><Metrics items={service.metrics} note={service.metricsNote} /></div>
      </div></section>

      <CtaBand title="Delivered through either path." description="Whether this starts as a 72-Hour Diagnostic or a full Foundations build depends on where you're starting — not this pillar specifically." href="/approach/" label="See Our Approach" />
    </div>
  ) : (
    <>
      <PageIntro eyebrow={service.eyebrow} title={service.title} description={service.summary}><p class="page-intro__description"><strong>{service.thesisLabel}:</strong> {service.thesis}</p></PageIntro>
      <section class="section section--paper"><div class="shell"><div class="section__heading"><p class="eyebrow">How We Work This Pillar</p><h2>Six workstreams, applied to your specific gap.</h2></div><WorkstreamGrid items={service.workstreams} /></div></section>
      <section class="section section--soft"><div class="shell"><div class="section__heading"><p class="eyebrow">Results</p></div><Metrics items={service.metrics} note={service.metricsNote} /></div></section>
      <CtaBand title="Delivered through either path." description="Whether this starts as a 72-Hour Diagnostic or a full Foundations build depends on where you're starting — not this pillar specifically." href="/approach/" label="See Our Approach" />
    </>
  )}
</BaseLayout>
