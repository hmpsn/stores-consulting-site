---
import { getCollection } from 'astro:content';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import ServicePageContent from '../../components/editable/ServicePageContent.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getService } from '../../lib/tina-data';
import { tinaIslands } from '../../lib/tina-islands';

export async function getStaticPaths() {
  return (await getCollection('services')).map((service) => ({
    params: { slug: service.data.slug },
    props: { slug: service.data.slug },
  }));
}

const { slug } = Astro.props;
const service = await getService(slug);
const data = service.data.service;
---

<BaseLayout title={data.title} description={data.summary} canonicalPath={`/services/${slug}/`} navSection="services">
  <TinaIsland name="service" wrapper={tinaIslands.service.wrapper} params={{ slug }} primary>
    <ServicePageContent data={data} />
  </TinaIsland>
</BaseLayout>
