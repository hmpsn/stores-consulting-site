---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import AboutPageContent from '../../components/editable/AboutPageContent.astro';
import { getMarketingPage } from '../../lib/tina-extended-data';
const { data, related } = await getMarketingPage('about');
const copy = data.copy;
---
<BaseLayout title={copy.title1} description={copy.description2} canonicalPath="/about/" navSection="about">
<TinaIsland name="aboutPage" params={{}} primary wrapper={{tag:"div"}}>
<AboutPageContent data={data} related={related} />
</TinaIsland>
</BaseLayout>
