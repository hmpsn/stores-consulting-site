---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CtaBand from '../../components/CtaBand.astro';
import logos from '../../data/mockup-client-logos.json';

const clients = (await getCollection('clients')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const clientBySlug = new Map(clients.map((client) => [client.data.slug, client.data]));
---
<BaseLayout title="Clients" description="A representative sample of national and regional retailers served by the Stores Consulting Group." canonicalPath="/clients/">
  <PageIntro eyebrow="Our Clients" title="100+ retailers since 2009. A few who've let us say so." description="We don't publish a client list — most engagements stay confidential, and we honor that by default. What follows is a representative sample of organizations who've specifically given us permission to use their name." />
  <section class="section"><div class="shell"><div class="client-logo-grid">{logos.map((logo) => { const client = clientBySlug.get(logo.slug); return <a class="client-logo-card" href={client?.route || '/clients/'}><img src={logo.path} width={logo.width} height={logo.height} alt={`${client?.name || logo.name} logo`} loading="lazy" /><span>{client?.name || logo.name}</span></a>; })}</div><p class="metrics__note">A sample, not a roster — dozens more across grocery, specialty, convenience, and value retail, under the confidentiality every engagement starts with by default.</p></div></section>
  <section class="section section--soft"><div class="shell"><div class="section__heading"><p class="eyebrow">Legacy Client Profiles</p><h2>Existing project URLs, preserved.</h2><p>Every public WordPress client/project entry remains available at its original route.</p></div><ul class="principle-grid">{clients.map((client) => <li><a class="text-link" href={client.data.route}>{client.data.name}</a></li>)}</ul></div></section>
  <CtaBand title="$12B in profit created, across every kind of store there is." description="That's not luck. That's a portable standard." />
</BaseLayout>
