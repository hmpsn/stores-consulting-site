---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import ApproachPageContent from '../../components/editable/ApproachPageContent.astro';
import { getMarketingPage } from '../../lib/tina-extended-data';
const { data, related } = await getMarketingPage('approach');
const copy = data.copy;
---
<BaseLayout title={copy.title1} description={copy.description2} canonicalPath="/approach/" navSection="approach">
<TinaIsland name="approachPage" params={{}} primary wrapper={{tag:"div"}}>
<ApproachPageContent data={data} related={related} />
</TinaIsland>
</BaseLayout>
