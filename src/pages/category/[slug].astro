---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import EditorialPageContent from '../../components/editable/EditorialPageContent.astro';
import {getEditorialPage} from '../../lib/tina-extended-data';
export async function getStaticPaths() {return (await getCollection('categories')).map(entry=>({params:{slug:entry.data.slug},props:{path:entry.filePath!.split('/').pop()!}}));}
const path = Astro.props.path;
const content = await getEditorialPage('category',path);
const data = content.data;
---
<BaseLayout title={data.name} description={data.description || `tSCG articles filed under ${data.name}.`} canonicalPath={data.route} navSection="blog">
<TinaIsland name="category" params={{path}} primary wrapper={{tag:"div"}}><EditorialPageContent {...content}/></TinaIsland>
</BaseLayout>
