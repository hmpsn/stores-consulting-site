---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import LegacyCaseStudyGrid from '../components/LegacyCaseStudyGrid.astro';
import mediaManifest from '../data/media-manifest.json';

export async function getStaticPaths() {
  const explicitRoutes = new Set(['/', '/about/', '/approach/', '/results/', '/clients/', '/services/', '/contact-us/', '/tscg-blog/']);
  const pages = (await getCollection('legacy-pages')).filter((entry) => !explicitRoutes.has(entry.data.route)).map((entry) => ({ params: { slug: entry.data.route.replace(/^\//, '').replace(/\/$/, '') }, props: { entry, type: 'page', description: entry.data.description, published: null } }));
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).map((entry) => ({ params: { slug: entry.data.route.replace(/^\//, '').replace(/\/$/, '') }, props: { entry, type: 'post', description: entry.data.excerpt || entry.data.title, published: entry.data.publishedDate } }));
  return [...pages, ...posts];
}
const { entry, type, description, published } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const canonicalPath = data.route;
const featuredPath = type === 'post' && 'featuredMedia' in data ? data.featuredMedia : null;
const featuredRecord = featuredPath ? mediaManifest.find((item) => item.path === featuredPath) : null;
const featuredMedia = featuredPath && featuredRecord?.width && featuredRecord?.height ? {
  src: featuredPath,
  alt: featuredRecord.alt || featuredRecord.title,
  width: featuredRecord.width,
  height: featuredRecord.height,
  position: 'center',
} : undefined;
const isCaseStudies = canonicalPath === '/case-studies/';
---
<BaseLayout title={data.title} description={description} canonicalPath={canonicalPath} article={type === 'post'}>
  <PageIntro eyebrow={type === 'post' ? 'tSCG Blog' : undefined} title={data.title} description={description} media={featuredMedia} compact />
  <article class="section"><div class:list={['shell', { prose: !isCaseStudies }]} data-reveal>
    {published && <p class="article-meta">Published {published.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>}
    {isCaseStudies ? <LegacyCaseStudyGrid source={entry.body ?? ''} /> : <Content />}
  </div></article>
</BaseLayout>
