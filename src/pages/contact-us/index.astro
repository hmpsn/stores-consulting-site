---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import ContactPageContent from '../../components/editable/ContactPageContent.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContactPage } from '../../lib/tina-data';
import { tinaIslands } from '../../lib/tina-islands';

const status = Astro.url.searchParams.get('status');
const page = await getContactPage();
const data = page.data.contactPage;
const metadata = data.metadata!;
---

<BaseLayout title={metadata.title} description={metadata.description} canonicalPath="/contact-us/" navSection="contact">
  <TinaIsland name="contact" wrapper={tinaIslands.contact.wrapper} params={{ status: status ?? '' }} primary>
    <ContactPageContent data={data} status={status} />
  </TinaIsland>
  <script>
    document.addEventListener('submit', async (event) => {
      const form = event.target;
      if (!(event instanceof SubmitEvent) || !(form instanceof HTMLFormElement) || !form.matches('[data-enhanced-contact]') || !window.fetch) return;
      event.preventDefault();
      const feedback = form.querySelector('[data-form-feedback]');
      const submitter = event.submitter;
      if (submitter instanceof HTMLButtonElement) submitter.disabled = true;
      if (feedback) feedback.textContent = 'Sending…';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Please review the form and try again.');
        form.reset();
        if (feedback) feedback.textContent = 'Thank you. Your message has been sent.';
      } catch (error) {
        if (feedback) feedback.textContent = error instanceof Error ? error.message : 'The form is temporarily unavailable.';
      } finally {
        if (submitter instanceof HTMLButtonElement) submitter.disabled = false;
      }
    });
  </script>
</BaseLayout>
