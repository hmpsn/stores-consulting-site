---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import EditorialPageContent from '../../components/editable/EditorialPageContent.astro';
import {getEditorialPage} from '../../lib/tina-extended-data';
export async function getStaticPaths() {return (await getCollection('clients')).map(entry=>({params:{slug:entry.data.slug},props:{path:entry.filePath!.split('/').pop()!}}));}
const path = Astro.props.path;
const content = await getEditorialPage('clientProfile',path);
const data = content.data;
---
<BaseLayout breadcrumbParent="clients" seo={data.seo} title={data.name} description={data.description || `${data.name} client profile from the Stores Consulting Group.`} canonicalPath={data.route} navSection="clients">
<TinaIsland name="clientProfile" params={{path}} primary wrapper={{tag:"div"}}><EditorialPageContent {...content}/></TinaIsland>
</BaseLayout>
